# Copy this file to `.env` and fill in the real values before `bun run build`.
# Every variable here is PUBLIC: it is embedded in the HTML/JS sent to browsers.
# Never put passwords, API keys or tokens in this project.

# Optional. Production domain, without a trailing slash (default: https://afmarketing.mx).
# Used for canonical URLs, hreflang, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://afmarketing.mx

# Optional. A form backend that accepts JSON POST requests with CORS
# (for example Formspree: https://formspree.io/f/xxxxxxx).
# Leave empty and the contact form sends the brief by WhatsApp or email instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# AF Marketing — Apache configuration for the static export.
# Ships inside /out. Upload it together with the site files (it is a hidden file).

Options -Indexes
DirectoryIndex index.html

# Branded 404 page generated by Next.js.
ErrorDocument 404 /404.html

# Force HTTPS on the canonical domain (https://afmarketing.mx):
# http:// and www. both redirect with a 301.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Plain HTTP (also when SSL is terminated by a proxy/CDN that sets X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://afmarketing.mx%{REQUEST_URI} [L,R=301]
  # www → bare domain.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://afmarketing.mx%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
</IfModule>

# Compress text responses (HTML, CSS, JS, RSC payloads, SVG, JSON).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript \
    application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images and icons: a week (file names are stable, contents may be replaced).
  <ElseIf "%{REQUEST_URI} =~ m#\.(avif|webp|jpe?g|png|svg|ico)$#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  # Pages and data: always revalidate so new deploys show up immediately.
  <Else>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Else>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Browsers remember to use HTTPS for a year.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
